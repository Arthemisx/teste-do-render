{
  "type": "APL",
  "version": "1.7",
  "theme": "dark",
  "import": [
    {
      "name": "alexa-layouts",
      "version": "1.4.0"
    }
  ],
  "resources": [
    {
      "name": "colorGradient",
      "values": [
        {
          "color": "#667eea"
        },
        {
          "color": "#764ba2"
        }
      ]
    }
  ],
  "styles": {
    "titleStyle": {
      "values": [
        {
          "fontSize": "48dp",
          "fontWeight": "bold",
          "color": "#667eea"
        }
      ]
    },
    "subtitleStyle": {
      "values": [
        {
          "fontSize": "28dp",
          "color": "#CCCCCC"
        }
      ]
    },
    "textStyle": {
      "values": [
        {
          "fontSize": "24dp",
          "color": "#FFFFFF"
        }
      ]
    },
    "buttonStyle": {
      "values": [
        {
          "backgroundColor": "#667eea",
          "borderRadius": "20dp",
          "height": "60dp"
        }
      ]
    }
  },
  "mainTemplate": {
    "parameters": [
      "payload"
    ],
    "items": [
      {
        "type": "Container",
        "width": "100%",
        "height": "100%",
        "items": [
          {
            "type": "Container",
            "position": "absolute",
            "left": "20dp",
            "top": "20dp",
            "width": "60dp",
            "height": "60dp",
            "items": [
              {
                "when": "${payload.mainScreenData.showStatsButton}",
                "type": "TouchWrapper",
                "id": "statsButton",
                "onPress": {
                  "type": "SendEvent",
                  "arguments": [
                    "show_stats"
                  ]
                },
                "item": {
                  "type": "Frame",
                  "width": "60dp",
                  "height": "60dp",
                  "backgroundColor": "#FFFFFF",
                  "borderRadius": "30dp",
                  "item": {
                    "type": "VectorGraphic",
                    "source": "chartIcon"
                  }
                }
              }
            ]
          },
          {
            "type": "Container",
            "width": "100%",
            "height": "100%",
            "alignItems": "center",
            "justifyContent": "center",
            "padding": "40dp",
            "items": [
              {
                "type": "Container",
                "width": "90%",
                "backgroundColor": "#FFFFFF",
                "borderRadius": "20dp",
                "padding": "40dp",
                "shadow": {
                  "horizontalOffset": 0,
                  "verticalOffset": 10,
                  "radius": 20,
                  "color": "#40000000"
                },
                "items": [
                  {
                    "type": "Text",
                    "text": "${payload.mainScreenData.title}",
                    "style": "titleStyle",
                    "textAlign": "center",
                    "textAlignVertical": "center"
                  },
                  {
                    "type": "Text",
                    "text": "${payload.mainScreenData.subtitle}",
                    "style": "subtitleStyle",
                    "textAlign": "center",
                    "marginTop": "20dp"
                  },
                  {
                    "type": "Text",
                    "text": "${payload.mainScreenData.description}",
                    "style": "textStyle",
                    "multiline": true,
                    "marginTop": "30dp",
                    "textAlign": "center"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "layouts": {
    "MainScreen": {
      "parameters": [
        "title",
        "subtitle",
        "description",
        "showStatsButton"
      ],
      "items": [
        {
          "type": "Container",
          "width": "100%",
          "height": "100%",
          "items": [
            {
              "type": "Container",
              "position": "absolute",
              "left": "20dp",
              "top": "20dp",
              "width": "60dp",
              "height": "60dp",
              "items": [
                {
                  "when": "${showStatsButton}",
                  "type": "TouchWrapper",
                  "id": "statsButton",
                  "onPress": {
                    "type": "SendEvent",
                    "arguments": [
                      "show_stats"
                    ]
                  },
                  "item": {
                    "type": "Frame",
                    "width": "60dp",
                    "height": "60dp",
                    "backgroundColor": "#FFFFFF",
                    "borderRadius": "30dp",
                    "item": {
                      "type": "VectorGraphic",
                      "source": "chartIcon"
                    }
                  }
                }
              ]
            },
            {
              "type": "Container",
              "width": "100%",
              "height": "100%",
              "alignItems": "center",
              "justifyContent": "center",
              "padding": "40dp",
              "items": [
                {
                  "type": "Container",
                  "width": "90%",
                  "backgroundColor": "#FFFFFF",
                  "borderRadius": "20dp",
                  "padding": "40dp",
                  "shadow": {
                    "horizontalOffset": 0,
                    "verticalOffset": 10,
                    "radius": 20,
                    "color": "#40000000"
                  },
                  "items": [
                    {
                      "type": "Text",
                      "text": "${title}",
                      "style": "titleStyle",
                      "textAlign": "center",
                      "textAlignVertical": "center"
                    },
                    {
                      "type": "Text",
                      "text": "${subtitle}",
                      "style": "subtitleStyle",
                      "textAlign": "center",
                      "marginTop": "20dp"
                    },
                    {
                      "type": "Text",
                      "text": "${description}",
                      "style": "textStyle",
                      "multiline": true,
                      "marginTop": "30dp",
                      "textAlign": "center"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "JogoNaoPertenceScreen": {
      "parameters": [
        "tema",
        "itens"
      ],
      "items": [
        {
          "type": "Container",
          "width": "100%",
          "height": "100%",
          "items": [
            {
              "type": "AlexaHeader",
              "headerTitle": "Qual não pertence?",
              "headerSubtitle": "Tema: ${tema}"
            },
            {
              "type": "Container",
              "width": "90%",
              "marginLeft": "5%",
              "marginTop": "20dp",
              "items": [
                {
                  "type": "Container",
                  "width": "100%",
                  "direction": "row",
                  "justifyContent": "space-between",
                  "items": [
                    {
                      "type": "Container",
                      "width": "45%",
                      "items": [
                        {
                          "type": "Image",
                          "source": "${itens[0].imagem}",
                          "width": "100%",
                          "height": "200dp",
                          "scale": "fill",
                          "borderRadius": "15dp"
                        },
                        {
                          "type": "Text",
                          "text": "${itens[0].nome}",
                          "fontSize": "24dp",
                          "textAlign": "center",
                          "marginTop": "10dp"
                        }
                      ]
                    },
                    {
                      "type": "Container",
                      "width": "45%",
                      "items": [
                        {
                          "type": "Image",
                          "source": "${itens[1].imagem}",
                          "width": "100%",
                          "height": "200dp",
                          "scale": "fill",
                          "borderRadius": "15dp"
                        },
                        {
                          "type": "Text",
                          "text": "${itens[1].nome}",
                          "fontSize": "24dp",
                          "textAlign": "center",
                          "marginTop": "10dp"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "Container",
                  "width": "100%",
                  "direction": "row",
                  "justifyContent": "space-between",
                  "marginTop": "20dp",
                  "items": [
                    {
                      "type": "Container",
                      "width": "45%",
                      "items": [
                        {
                          "type": "Image",
                          "source": "${itens[2].imagem}",
                          "width": "100%",
                          "height": "200dp",
                          "scale": "fill",
                          "borderRadius": "15dp"
                        },
                        {
                          "type": "Text",
                          "text": "${itens[2].nome}",
                          "fontSize": "24dp",
                          "textAlign": "center",
                          "marginTop": "10dp"
                        }
                      ]
                    },
                    {
                      "type": "Container",
                      "width": "45%",
                      "items": [
                        {
                          "type": "Image",
                          "source": "${itens[3].imagem}",
                          "width": "100%",
                          "height": "200dp",
                          "scale": "fill",
                          "borderRadius": "15dp"
                        },
                        {
                          "type": "Text",
                          "text": "${itens[3].nome}",
                          "fontSize": "24dp",
                          "textAlign": "center",
                          "marginTop": "10dp"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "StatsScreen": {
      "parameters": [
        "totalTime",
        "dailyStats"
      ],
      "items": [
        {
          "type": "Container",
          "width": "100%",
          "height": "100%",
          "items": [
            {
              "type": "Container",
              "position": "absolute",
              "left": "20dp",
              "top": "20dp",
              "width": "60dp",
              "height": "60dp",
              "items": [
                {
                  "type": "TouchWrapper",
                  "id": "backButton",
                  "onPress": {
                    "type": "SendEvent",
                    "arguments": [
                      "go_back"
                    ]
                  },
                  "item": {
                    "type": "Frame",
                    "width": "60dp",
                    "height": "60dp",
                    "backgroundColor": "#FFFFFF",
                    "borderRadius": "30dp",
                    "item": {
                      "type": "Text",
                      "text": "←",
                      "fontSize": "40dp",
                      "color": "#667eea",
                      "textAlign": "center",
                      "textAlignVertical": "center"
                    }
                  }
                }
              ]
            },
            {
              "type": "AlexaHeader",
              "headerTitle": "Estatísticas",
              "headerSubtitle": "Seu progresso"
            },
            {
              "type": "Container",
              "width": "90%",
              "marginLeft": "5%",
              "marginTop": "20dp",
              "items": [
                {
                  "type": "Container",
                  "width": "100%",
                  "backgroundColor": "#F5F5F5",
                  "borderRadius": "15dp",
                  "padding": "20dp",
                  "marginBottom": "15dp",
                  "items": [
                    {
                      "type": "Text",
                      "text": "Tempo Total de Uso",
                      "fontSize": "24dp",
                      "color": "#555555"
                    },
                    {
                      "type": "Text",
                      "text": "${totalTime} min",
                      "fontSize": "36dp",
                      "color": "#667eea",
                      "fontWeight": "bold",
                      "marginTop": "10dp"
                    }
                  ]
                },
                {
                  "type": "Text",
                  "text": "Estatísticas por Dia",
                  "fontSize": "28dp",
                  "color": "#667eea",
                  "fontWeight": "bold",
                  "marginTop": "20dp",
                  "marginBottom": "15dp"
                },
                {
                  "type": "Sequence",
                  "id": "dailyStatsList",
                  "width": "100%",
                  "height": "400dp",
                  "data": "${dailyStats}",
                  "item": [
                    {
                      "type": "Container",
                      "width": "100%",
                      "backgroundColor": "#F5F5F5",
                      "borderRadius": "15dp",
                      "padding": "15dp",
                      "marginBottom": "10dp",
                      "items": [
                        {
                          "type": "Container",
                          "width": "100%",
                          "direction": "row",
                          "justifyContent": "space-between",
                          "items": [
                            {
                              "type": "Text",
                              "text": "${data.date}",
                              "fontSize": "20dp",
                              "color": "#888888"
                            },
                            {
                              "type": "Text",
                              "text": "${data.time} min",
                              "fontSize": "24dp",
                              "color": "#667eea",
                              "fontWeight": "bold"
                            }
                          ]
                        },
                        {
                          "type": "Container",
                          "width": "100%",
                          "direction": "row",
                          "marginTop": "10dp",
                          "items": [
                            {
                              "type": "Text",
                              "text": "✓ ${data.correct} acertos",
                              "fontSize": "20dp",
                              "color": "#28A745",
                              "marginRight": "20dp"
                            },
                            {
                              "type": "Text",
                              "text": "✗ ${data.wrong} erros",
                              "fontSize": "20dp",
                              "color": "#DC3545"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "graphics": {
    "chartIcon": {
      "type": "AVG",
      "description": "Chart icon",
      "width": 40,
      "height": 40,
      "items": [
        {
          "type": "path",
          "fill": "#667eea",
          "pathData": "M10,35 L10,15 M20,35 L20,5 M30,35 L30,25",
          "strokeWidth": 3
        }
      ]
    }
  }
}

